{
  "name": "Byte Core — Linux capability testing",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".",
    "options": ["--platform=linux/amd64"]
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/byte-core,type=bind,readonly",
  "workspaceFolder": "/workspaces/byte-core",
  "remoteUser": "byte-test",
  "updateRemoteUserUID": false,
  "userEnvProbe": "none",
  "runArgs": [
    "--platform=linux/amd64",
    "--cap-drop=ALL",
    "--security-opt=no-new-privileges:true"
  ],
  "postCreateCommand": ["./bin/byte", "check"],
  "shutdownAction": "stopContainer"
}
